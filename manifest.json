{
  "manifest_version": 3,
  "name": "GrokPlayer",
  "version": "1.10.11",
  "description": "Open YouTube, Kick, Twitch, and sniffed HLS/DASH streams in GrokPlayer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GrokPlayer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "settings/settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs", "webRequest"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://www.youtube-nocookie.com/*",
    "https://kick.com/*",
    "https://www.twitch.tv/*",
    "https://*.twitch.tv/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content/langs.js", "content/probe-page.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["content/langs.js", "content/chip.js", "content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
      "js": ["content/langs.js", "content/probe-page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://youtu.be/*"
      ],
      "js": ["content/sniff.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://youtu.be/*"
      ],
      "js": ["content/chip.js", "content/open-chip.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_idle"
    }
  ]
}
